{
  "info": {
    "name": "Library API",
    "_postman_id": "8b5b3d1d-1111-2222-3333-abcdefabcdef",
    "description": "Basic Postman collection for Library API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "adminRefreshToken", "value": "" },
    { "key": "reservationId", "value": "" },
    { "key": "bookId", "value": "1" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/register",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"test@example.com\",\"password\":\"secret123\",\"name\":\"User\",\"address\":\"Addr\",\"date_of_birth\":\"2000-01-01\"}"
        }
      }
    },
    {
      "name": "Login (member)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var data = pm.response.json();",
              "if (data.access_token) pm.collectionVariables.set('token', data.access_token);",
              "if (data.refresh_token) pm.collectionVariables.set('refreshToken', data.refresh_token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/login",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"test@example.com\",\"password\":\"secret123\"}" }
      }
    },
    {
      "name": "Login (admin seed)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var data = pm.response.json();",
              "if (data.access_token) pm.collectionVariables.set('adminToken', data.access_token);",
              "if (data.refresh_token) pm.collectionVariables.set('adminRefreshToken', data.refresh_token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/login",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@library.hu\",\"password\":\"admin123456.!\"}"
        }
      }
    },
    {
      "name": "Refresh token (member)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/token/refresh",
        "header": [{ "key": "Authorization", "value": "Bearer {{refreshToken}}" }]
      }
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/me",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
      }
    },
    {
      "name": "Books list",
      "request": { "method": "GET", "url": "{{baseUrl}}/books" }
    },
    {
      "name": "Create loan (book-level)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/loans",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"book_id\":{{bookId}},\"loan_days\":7}" }
      }
    },
    {
      "name": "Create reservation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var data = pm.response.json();",
              "if (data.reservation_id) pm.collectionVariables.set('reservationId', data.reservation_id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/reservations",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"book_id\":{{bookId}}}" }
      }
    },
    {
      "name": "My reservations (all)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users/1/reservations?status=all",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
      }
    },
    {
      "name": "Cancel reservation",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/reservations/{{reservationId}}/cancel",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
      }
    },
    {
      "name": "Admin stats",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/admin/stats",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
      }
    },
    {
      "name": "Admin waitlist",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/admin/waitlist?waiting_only=true&limit=200",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
      }
    },
    {
      "name": "Admin list items for book",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/admin/books/{{bookId}}/items",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
      }
    },
    {
      "name": "Admin add items for book",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/admin/books/{{bookId}}/items",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"count\":1,\"library_id\":1,\"item_condition\":\"good\",\"shelf_mark_prefix\":\"AUTO\"}"
        }
      }
    },
    {
      "name": "Admin remove one available item",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/admin/books/{{bookId}}/items/remove_one",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
      }
    }
  ]
}
